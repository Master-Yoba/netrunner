[node name="SeedLabel" type="Label" parent="SetupContent"]
layout_mode = 2
theme_override_colors/font_color = Color(0.65, 0.74, 0.8, 1)
theme_override_font_sizes/font_size = 11
text = "Game seed"

[node name="SeedInput" type="LineEdit" parent="SetupContent"]
unique_name_in_owner = true
