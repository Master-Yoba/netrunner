[gd_scene format=3]

[ext_resource type="Theme" path="res://themes/M4Theme.tres" id="theme"]

[sub_resource type="StyleBoxFlat" id="surface"]
bg_color = Color(0.018, 0.035, 0.05, 0.98)
border_color = Color(0.36, 0.9, 0.74, 1)
border_width_left = 2
border_width_top = 2
border_width_right = 2
border_width_bottom = 2
corner_radius_top_left = 10
corner_radius_top_right = 10
corner_radius_bottom_left = 10
corner_radius_bottom_right = 10
content_margin_left = 18.0
content_margin_top = 16.0
content_margin_right = 18.0
content_margin_bottom = 16.0

[node name="PileBrowser" type="PanelContainer"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 0
theme = ExtResource("theme")
theme_override_styles/panel = SubResource("surface")

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 2
theme_override_constants/margin_left = 24
theme_override_constants/margin_top = 18
theme_override_constants/margin_right = 24
theme_override_constants/margin_bottom = 18

[node name="Content" type="VBoxContainer" parent="Margin"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="Title" type="Label" parent="Margin/Content"]
unique_name_in_owner = true
layout_mode = 2
theme_override_font_sizes/font_size = 20
theme_override_colors/font_color = Color(0.36, 0.9, 0.74, 1)
text = "PILE"
autowrap_mode = 3

[node name="Summary" type="Label" parent="Margin/Content"]
unique_name_in_owner = true
layout_mode = 2
theme_override_font_sizes/font_size = 12
text = "Public cards in this pile"
autowrap_mode = 3

[node name="CardsScroll" type="ScrollContainer" parent="Margin/Content"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 3
horizontal_scroll_mode = 0
follow_focus = true
clip_contents = true

[node name="Cards" type="GridContainer" parent="Margin/Content/CardsScroll"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
columns = 4
theme_override_constants/h_separation = 10
theme_override_constants/v_separation = 10

[node name="Close" type="Button" parent="Margin/Content"]
unique_name_in_owner = true
layout_mode = 2
custom_minimum_size = Vector2(180, 40)
text = "Close pile"
tooltip_text = "Close the pile browser and return to the table"
