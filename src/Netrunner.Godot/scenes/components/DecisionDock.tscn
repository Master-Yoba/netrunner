[gd_scene format=3]

[ext_resource type="Theme" path="res://themes/M4Theme.tres" id="theme"]

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_vdsmm"]
content_margin_left = 10.0
content_margin_top = 8.0
content_margin_right = 10.0
content_margin_bottom = 8.0
bg_color = Color(0.055, 0.08, 0.105, 1)
border_width_left = 1
border_width_top = 1
border_width_right = 1
border_width_bottom = 1
border_color = Color(0.17, 0.28, 0.34, 1)
corner_radius_top_left = 7
corner_radius_top_right = 7
corner_radius_bottom_right = 7
corner_radius_bottom_left = 7

[node name="DecisionDock" type="PanelContainer"]
layout_mode = 2
theme_override_styles/panel = SubResource("StyleBoxFlat_vdsmm")

theme = ExtResource("theme")

[node name="Content" type="VBoxContainer" parent="."]
unique_name_in_owner = true
layout_mode = 2

[node name="PromptRow" type="HBoxContainer" parent="Content"]
unique_name_in_owner = true
layout_mode = 2

[node name="Prompt" type="Label" parent="Content/PromptRow"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
theme_override_colors/font_color = Color(1, 1, 1, 1)
theme_override_font_sizes/font_size = 15
autowrap_mode = 3

[node name="Inspect" type="Button" parent="Content/PromptRow"]
unique_name_in_owner = true
layout_mode = 2
disabled = true
text = "Inspect a card"

[node name="ActionsViewport" type="Control" parent="Content"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 48)
layout_mode = 2
size_flags_vertical = 3

[node name="ActionsScroll" type="ScrollContainer" parent="Content/ActionsViewport"]
unique_name_in_owner = true
layout_mode = 0
anchor_right = 1.0
anchor_bottom = 1.0
follow_focus = true
horizontal_scroll_mode = 0

[node name="Actions" type="HFlowContainer" parent="Content/ActionsViewport/ActionsScroll"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3

[node name="FocusPresentation" type="VBoxContainer" parent="Content"]
unique_name_in_owner = true
layout_mode = 2
