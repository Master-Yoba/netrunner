[gd_scene format=3]

[ext_resource type="Script" path="res://scenes/Main.cs" id="main"]
[ext_resource type="Theme" path="res://themes/M4Theme.tres" id="theme"]
[ext_resource type="PackedScene" path="res://scenes/components/MatchSetup.tscn" id="setup"]
[ext_resource type="PackedScene" path="res://scenes/components/MatchTable.tscn" id="table"]
[ext_resource type="PackedScene" path="res://scenes/components/CardInspection.tscn" id="inspection"]

[ext_resource type="PackedScene" path="res://scenes/components/PileBrowser.tscn" id="piles"]

[ext_resource type="PackedScene" path="res://scenes/components/InteractionLabToolbar.tscn" id="lab"]
[ext_resource type="PackedScene" path="res://scenes/components/SettingsMenu.tscn" id="settings"]
[ext_resource type="Texture2D" path="res://icons/settings.svg" id="cog"]

[node name="Main" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("main")
theme = ExtResource("theme")

[node name="Backdrop" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
color = Color(0.025, 0.04, 0.055, 1)

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/margin_left = 10
theme_override_constants/margin_top = 8
theme_override_constants/margin_right = 10
theme_override_constants/margin_bottom = 8

[node name="Layout" type="VBoxContainer" parent="Margin"]
layout_mode = 2
size_flags_vertical = 3
theme_override_constants/separation = 6

[node name="Header" type="HBoxContainer" parent="Margin/Layout"]
layout_mode = 2
custom_minimum_size = Vector2(0, 36)
theme_override_constants/separation = 10

[node name="Title" type="Label" parent="Margin/Layout/Header"]
layout_mode = 2
theme_type_variation = &"AppTitle"
text = "NETRUNNER SOLO"
vertical_alignment = 1

[node name="Status" type="Label" parent="Margin/Layout/Header"]
layout_mode = 2
size_flags_horizontal = 3
theme_type_variation = &"AppStatus"
text = "Match setup · waiting for a preset"
text_overrun_behavior = 3
vertical_alignment = 1

[node name="Phase" type="Label" parent="Margin/Layout/Header"]
layout_mode = 2
theme_type_variation = &"PhaseLabel"
text = "SETUP"
horizontal_alignment = 2
vertical_alignment = 1

[node name="InteractionLabToolbar" parent="Margin/Layout/Header" instance=ExtResource("lab")]
layout_mode = 2

[node name="NewGame" type="Button" parent="Margin/Layout/Header"]
layout_mode = 2
text = "New game"

[node name="SkipAnimation" type="Button" parent="Margin/Layout/Header"]
layout_mode = 2
text = "Skip animation"

[node name="StopAtWindow" type="Button" parent="Margin/Layout/Header"]
layout_mode = 2
toggle_mode = true
text = "Stop"
tooltip_text = "Stop at the next optional window instead of passing it."
accessibility_name = "Stop at the next optional window"

[node name="Settings" type="Button" parent="Margin/Layout/Header"]
layout_mode = 2
custom_minimum_size = Vector2(36, 36)
icon = ExtResource("cog")
tooltip_text = "Settings"
accessibility_name = "Settings"

[node name="MatchSetup" parent="Margin/Layout" instance=ExtResource("setup")]
layout_mode = 2

[node name="MatchTable" parent="Margin/Layout" instance=ExtResource("table")]
visible = false
layout_mode = 2

[node name="PileLayer" type="CanvasLayer" parent="."]
layer = 10

[node name="PileBrowser" parent="PileLayer" instance=ExtResource("piles")]
visible = false

[node name="InspectionLayer" type="CanvasLayer" parent="."]
layer = 11

[node name="CardInspection" parent="InspectionLayer" instance=ExtResource("inspection")]
visible = false

[node name="SettingsLayer" type="CanvasLayer" parent="."]
layer = 12

[node name="SettingsMenu" parent="SettingsLayer" instance=ExtResource("settings")]
visible = false
